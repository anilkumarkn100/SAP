# SAP ADT MCP Server — Environment Variables
# Copy this to .env or paste into your Claude desktop config (env block)

# Required
SAP_HOST=your-s4hana-host.domain.com     # e.g. vhfihrd1ap01.sap.bsriil.com
SAP_CLIENT=200                            # SAP client number (200=Dev, 210=QA, etc.)
SAP_USER=YOUR_USER                        # SAP username (e.g. INFRA_SAC)
SAP_PASSWORD=YOUR_PASSWORD                # SAP password

# Optional (defaults shown)
SAP_PORT=44300                            # HTTPS port for SAP ADT
